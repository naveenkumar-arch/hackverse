# ============================================================================
# HackVerse - Environment Configuration Blueprint
# ============================================================================

# Application Environment
NODE_ENV=production
PORT=5000

# PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:password@localhost:5432/hackverse_db?schema=public"

# JWT Authentication Secrets
JWT_ACCESS_SECRET="hackverse_super_secret_access_jwt_key_2026_production"
JWT_REFRESH_SECRET="hackverse_super_secret_refresh_jwt_key_2026_production"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Frontend Application URL
CLIENT_URL="http://localhost:5173"

# Resend Email Automation API Key
RESEND_API_KEY="re_123456789_your_resend_production_key"

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME="hackverse-cloud"
CLOUDINARY_API_KEY="1234567890"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Stripe / UPI Payment Settings
STRIPE_SECRET_KEY="sk_test_123456"
UPI_ID="hackverse@upi"
